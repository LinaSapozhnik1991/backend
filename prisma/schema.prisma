generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Counter {
  key String @id
  seq Int    @default(0)

  @@map("counters")
}

model User {
  id           Int       @id
  login        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash")
  role         String    @default("editor") @db.VarChar(20)
  createdAt    DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Landing {
  id           Int       @id @default(autoincrement())
  /// ID сущности в Keitaro (лендинг или оффер); null — запись только в CRM. Уникальность вместе с record_type.
  keitaroId    Int?      @map("keitaro_id")
  name         String
  groupId      Int?      @map("group_id")
  state        String?
  localPath    String?   @map("local_path")
  previewPath  String?   @map("preview_path")
  landingType  String?   @map("landing_type")
  /// Группа в терминах CRM (отдельно от group_id Keitaro)
  groupName    String    @default("default") @map("group_name")
  recordType   String    @default("offer") @map("record_type") @db.VarChar(20)
  status       String    @default("active") @map("status") @db.VarChar(20)
  roi          Decimal?  @db.Decimal(10, 2)
  conversion   Decimal?  @db.Decimal(10, 2)
  cr           Decimal?  @db.Decimal(10, 2)
  crc          Decimal?  @db.Decimal(10, 2)
  createdAt    DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  @@unique([keitaroId, recordType])
  @@map("landings")
}

model WidgetCatalog {
  id         Int    @id @default(autoincrement())
  widgetKey  String @unique @map("widget_key")
  widgetName String @map("widget_name")
  sortOrder  Int    @map("sort_order")

  @@map("widget_catalog")
}

model ScriptCatalog {
  id         Int    @id @default(autoincrement())
  scriptKey  String @unique @map("script_key")
  scriptName String @map("script_name")
  sortOrder  Int    @map("sort_order")

  @@map("script_catalog")
}

model WidgetRow {
  id         Int     @id
  landingId  Int     @map("landing_id")
  widgetKey  String  @map("widget_key")
  widgetName String  @map("widget_name")
  isEnabled  Boolean @default(false) @map("is_enabled")
  sortOrder  Int     @default(0) @map("sort_order")

  @@unique([landingId, widgetKey], map: "widgets_landing_id_widget_key_key")
  @@index([landingId], map: "widgets_landing_id_idx")
  @@map("widgets")
}

model ScriptRow {
  id         Int     @id
  landingId  Int     @map("landing_id")
  scriptKey  String  @map("script_key")
  scriptName String  @map("script_name")
  isEnabled  Boolean @default(false) @map("is_enabled")
  sortOrder  Int     @default(0) @map("sort_order")

  @@unique([landingId, scriptKey], map: "scripts_landing_id_script_key_key")
  @@index([landingId], map: "scripts_landing_id_idx")
  @@map("scripts")
}

model SettingRow {
  id           Int    @id
  landingId    Int    @map("landing_id")
  settingKey   String @map("setting_key")
  settingValue String @default("") @map("setting_value")

  @@index([landingId], map: "settings_landing_id_idx")
  @@map("settings")
}

model HistoryEntry {
  id         Int      @id
  landingId  Int      @map("landing_id")
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityKey  String?  @map("entity_key")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([landingId], map: "history_landing_id_idx")
  @@index([userId], map: "history_user_id_idx")
  @@map("history")
}

model EntityTemplate {
  entity             String
  templateKey        String   @map("template_key")
  body               Bytes
  originalFilename   String?  @map("original_filename")
  mimeType           String?  @map("mime_type")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([entity, templateKey])
  @@map("entity_templates")
}

model FilterPreset {
  id                 Int      @id
  context            String
  name               String
  rules              Json
  savedFromContext   String?  @map("saved_from_context")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([context, createdAt], map: "filter_presets_context_created_idx")
  @@map("filter_presets")
}

model QueueSmokeLog {
  id        Int      @id @default(autoincrement())
  jobId     String   @map("job_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("queue_smoke_logs")
}

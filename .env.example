PORT=3000
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Проверка API без JWT: GET http://127.0.0.1:PORT/api/health
# DISABLE_AUTH=true

# --- PostgreSQL (основное хранилище приложения)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/crm_landings?schema=public

# --- MySQL (только для одноразовой миграции npm run db:migrate-mysql-to-mongo → Mongo; для Postgres используйте отдельный ETL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_landings
DB_USER=root
DB_PASSWORD=

# --- Redis (BullMQ) — см. ../docker-compose.infra.yml
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Секрет для GET /api/system/queue-smoke?token=... (проверка очереди + запись в PostgreSQL)
# QUEUE_SMOKE_TOKEN=dev_only_change_me

# --- Keitaro Admin API (синхронизация лендингов)
# Адрес трекера = схема + хост (как в документации), без пути /admin_api/...
# Пример: https://tracker.example.com  →  GET https://tracker.example.com/admin_api/v1/landing_pages
# KEITARO_BASE_URL=https://tracker.example.com
# KEITARO_API_KEY=
# KEITARO_AUTH_TYPE=api-key
# KEITARO_LANDINGS_ENDPOINT=/admin_api/v1/landing_pages
# Имена групп для поля group_name (GET …/groups + type=landings; при необходимости свой путь/ query):
# KEITARO_LANDINGS_GROUPS_ENDPOINT=/admin_api/v1/groups
# KEITARO_OFFERS_ENDPOINT=/admin_api/v1/offers
# (один оффер: GET {BASE}{KEITARO_OFFERS_ENDPOINT}/{id} — тот же JSON, что элемент списка; в коде: KeitaroService.fetchOfferById)
# KEITARO_OFFERS_PER_PAGE=100
# Имена групп офферов для group_name (GET …/groups + type=offers):
# KEITARO_OFFERS_GROUPS_ENDPOINT=/admin_api/v1/groups
# SYNC_CRON=*/15 * * * *   # периодическая синхронизация (по умолчанию каждые 15 мин)
# SYNC_CRON=off            # без cron; ключи Keitaro остаются — ручной POST /api/sync/keitaro
# KEITARO_SYNC_ON_START=false  # не синкать при старте/redeploy (только cron или ручной вызов)
# Запросы к Keitaro: по умолчанию IPv4 (Windows / битый IPv6). Отключить: KEITARO_HTTPS_USE_IPV4=false
# KEITARO_HTTPS_USE_IPV4=true
# Только отладка / доверенный трекер — отключить проверку TLS-сертификата:
# KEITARO_TLS_REJECT_UNAUTHORIZED=false
# Минимальная версия TLS к Keitaro (по умолчанию TLSv1.2):
# KEITARO_TLS_MIN_VERSION=TLSv1.2
# Обрыв TLS: проверьте, что для процесса Node не заданы лишние HTTP_PROXY/HTTPS_PROXY (к Keitaro axios идёт с proxy:false).

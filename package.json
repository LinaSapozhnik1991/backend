{
  "name": "crm-landings-api-nest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npx prisma generate",
    "build": "npx prisma generate && npx nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:fix-admin-password": "node scripts/fix-admin-password.cjs",
    "db:migrate-mysql-to-mongo": "node scripts/migrate-mysql-to-mongo.cjs"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^6.19.0",
    "axios": "^1.16.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "3.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "overrides": {
    "cron": "3.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
